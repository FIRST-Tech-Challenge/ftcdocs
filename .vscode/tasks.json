{
    "tasks": [
        {
            "type": "shell",
            "label": "make-setup",
            "command": "uv",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "sync"
            ],
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            // The docs/Makefile targets already invoke Sphinx through `uv run`,
            // so these need no environment activation of their own.
            "type": "shell",
            "label": "make-html",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-C",
                "docs",
                "html"
            ],
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "make-latexpdf",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-C",
                "docs",
                "latexpdf"
            ],
            "group": {
                "kind": "build",
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "make-autobuild",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-C",
                "docs",
                "autobuild"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "make-clean",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-C",
                "docs",
                "clean"
            ],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}
