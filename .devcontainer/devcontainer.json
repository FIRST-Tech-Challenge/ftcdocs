{
	"name": "FTC Docs",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	"postCreateCommand": "uv sync --locked",
	"customizations": {
		"vscode": {
			"extensions": [
				"lextudio.restructuredtext",
				"lextudio.restructuredtext-pack",
				"trond-snekvik.simple-rst",
				"ms-python.python"
			]
		}
	}
}
